# Скопируйте в .env (разработка) и .env.test (автотесты), затем задайте свои значения.
# Файлы .env* (кроме этого примера) в репозиторий не коммитятся.

NODE_ENV=development

# PostgreSQL (docker-compose.dev.yml)
POSTGRES_USER=iot
POSTGRES_PASSWORD=iot_dev_password
POSTGRES_PORT=5432

# Строка подключения Prisma. Для .env.test укажите базу iot_test.
DATABASE_URL=postgresql://iot:iot_dev_password@localhost:5432/iot_dev?schema=public

# API
API_PORT=3000

# Авторизация. JWT_SECRET — случайная строка не короче 32 символов (например, `openssl rand -hex 32`),
# разная для каждого окружения.
JWT_SECRET=
# Срок жизни access-токена, секунды (по умолчанию 900 = 15 минут).
JWT_ACCESS_TTL_SECONDS=900
# Число запросов входа с одного IP в минуту. Для .env.test можно увеличить (например, 1000).
LOGIN_RATE_LIMIT=20

# Каталог для загруженных файлов (библиотека материалов и заданий). Вне каталога статики.
# По умолчанию — storage/<NODE_ENV> в корне репозитория, у каждого окружения свой каталог.
# FILE_STORAGE_DIR=/var/lib/iot/files

# Журнал: уровень pino (error, warn, info, debug). По умолчанию info, в тестах error.
# LOG_LEVEL=info

# Пароли демо-учётных записей для `pnpm db:seed` (только для разработки).
# Если не заданы, сид сгенерирует пароли и выведет их в консоль.
SEED_ADMIN_PASSWORD=
SEED_TEACHER_PASSWORD=
SEED_STUDENT_PASSWORD=
SEED_RESEARCHER_PASSWORD=
