# Переменные рабочего окружения для docker-compose.standalone.yml.
# Скопируйте в .env.prod (не коммитится), задайте значения и ограничьте доступ: chmod 600 .env.prod.
# Подробное описание — docs/deploy/environment.md.

# Версия образов (метка при сборке), например дата выпуска.
IOT_VERSION=local

# PostgreSQL. Пароль — только латинские буквы и цифры (входит в строку подключения):
#   openssl rand -hex 24
POSTGRES_USER=iot
POSTGRES_PASSWORD=
POSTGRES_DB=iot

# Секрет подписи токенов: не короче 32 символов, свой для каждого окружения.
#   openssl rand -hex 32
JWT_SECRET=
JWT_ACCESS_TTL_SECONDS=900
LOGIN_RATE_LIMIT=20
LOG_LEVEL=info

# Порты сервера и каталог с сертификатом (fullchain.pem, privkey.pem).
HTTP_PORT=80
HTTPS_PORT=443
TLS_CERT_DIR=./deploy/certs

# Резервное копирование: расписание cron (время по TZ), число хранимых копий, каталог на сервере.
BACKUP_SCHEDULE=30 2 * * *
BACKUP_KEEP=14
BACKUP_HOST_DIR=./backups
TZ=Asia/Almaty
