{
  "rootDir": "src",
  "testEnvironment": "node",
  "testRegex": ".*\\.spec\\.ts$",
  "extensionsToTreatAsEsm": [".ts"],
  "moduleNameMapper": { "^(\\.{1,2}/.*)\\.js$": "$1" },
  "transform": {
    "^.+\\.ts$": ["ts-jest", { "useESM": true, "tsconfig": "<rootDir>/../tsconfig.json" }]
  },
  "passWithNoTests": true
}
