{
  "name": "@iot/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test --project=desktop --project=mobile-360 --project=firefox",
    "test:e2e:webkit": "docker run --rm --network host --user \"$(id -u):$(id -g)\" -e HOME=/tmp -e CI=1 -v \"$(cd ../.. && pwd)\":\"$(cd ../.. && pwd)\" -w \"$PWD\" mcr.microsoft.com/playwright:v1.64.1-noble node ./node_modules/@playwright/test/cli.js test --project=webkit"
  },
  "dependencies": {
    "@iot/shared": "workspace:*",
    "@primeuix/themes": "2.0.3",
    "@vee-validate/zod": "^4.15.1",
    "chart.js": "^4.5.1",
    "pinia": "^4.1.0",
    "primeicons": "7.0.0",
    "primevue": "4.5.5",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.44",
    "vue-chartjs": "^5.3.4",
    "vue-router": "^5.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^30.1.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  }
}
